Items: {
	SoulApparatusItem: {
		DisplayName: Soul Apparatus
		Tooltip: Dissolves a potion and a few souls into a permanent soulspell
	}

	GraftingAltarItem: {
		DisplayName: Grafting Altar
		Tooltip: Opens the body to boss Essence mutations
	}

	PulsingBait: {
		DisplayName: Pulsing Bait
		Tooltip: Summons The Soul Eater at night on the Surface
	}

	BorrowedSentence: {
		DisplayName: Borrowed Sentence
		Tooltip:
			'''
			Wounds dealing at least 10% of maximum life borrow 40% of their damage
			Deal 12 times the borrowed damage within 6 seconds to earn absolution
			Failure returns the borrowed damage
			14 second cooldown after judgment
			'''
	}

	Compeditus: {
		DisplayName: Compeditus
		Tooltip:
			'''
			Summons a shared core surrounded by up to four Congregation seals
			The choir no longer answers its wardens
			'''
	}

	Unison: {
		DisplayName: Unison
		Tooltip:
			'''
			Clap spectral fists to release a closed Hollow Benediction
			The hymn expands from the smash and strikes each enemy once
			'''
	}

	Crux: {
		DisplayName: Crux
		Tooltip:
			'''
			Marks the cursor with a crossed sentence
			Both arms strike each enemy once
			Uses bullets
			'''
	}

	CarrionCall: {
		DisplayName: Carrion Call
		Tooltip:
			'''
			Throws a meal that calls an Eater of Worlds from below
			The worm makes one frozen rise and dive through the bait
			Each enemy is scraped once; eating a tagged meal bites harder
			'''
	}

	StarsOfRuin: {
		DisplayName: Stars of Ruin
		Tooltip:
			'''
			Fires twelve dark shooting stars that pursue a chosen foe
			Aim near a visible enemy to lock the volley onto it
			'''
	}

	SealedCongregationBag: {
		DisplayName: The Sealed Congregation Treasure Bag
		Tooltip: Right-click to open
	}

	WardensFragment: {
		DisplayName: Warden's Fragment
		Tooltip:
			'''
			A fractured ward-sigil, warm with borrowed authority
			Right-click the Warden's Reliquary to open the court
			'''
	}

	CongregationEssence: {
		DisplayName: Congregation Essence
		Tooltip: Many imprisoned echoes condensed into one essence
	}

	TerraBladeFragment: {
		DisplayName: Terra Blade Fragment
		Tooltip:
			'''
			A genuine fragment of an ancient Terra Blade
			Right-click an Iron or Lead Anvil within a clear, supported 4x3 area to form the Terraforge
			'''
	}

