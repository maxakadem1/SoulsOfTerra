		DisplayName: Slimebound Blade
		Tooltip:
			'''
			Every swing releases a large piercing gel ball
			Every third swing releases three balls instead
			'''
	}

	EssenceboundBreakerBlade: {
		DisplayName: Essencebound Breaker Blade
		Tooltip:
			'''
			Throws up to five tethered blades that lodge in enemies or terrain
			Right-click recalls every blade in a damaging spin
			Extracting a lodged blade deals increased damage
			Distant and missed blades return automatically
			'''
	}

	ServantsGaze: {
		DisplayName: Servant's Gaze
		Tooltip:
			'''
			Releases three dormant servants
			They awaken after a moment and seek nearby enemies
			'''
	}

	MoonstoneStaff: {
		DisplayName: Moonstone Staff
		Tooltip:
			'''
			Gathers celestial mana before releasing a devastating moonstone bolt
			The bolt gently seeks enemies and erupts on impact
			'''
	}

	UnkemptHarold: {
		DisplayName: Unkempt Harold
		Tooltip:
			'''
			Consumes 3 bullets
			Fires three gyrojets that split twice into a vertical column of seven
			'''
	}
