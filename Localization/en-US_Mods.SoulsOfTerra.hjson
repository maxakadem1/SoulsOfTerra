Items: {
	BorrowedSentence: {
		DisplayName: Borrowed Sentence
		Tooltip:
			'''
			Wounds dealing at least 10% of maximum life borrow 40% of their damage
			Deal 12 times the borrowed damage within 6 seconds to earn absolution
			Failure returns the borrowed damage
			14 second cooldown after judgment
			'''
	}

	Compeditus: {
		DisplayName: Compeditus
		Tooltip:
			'''
			Summons a shared core surrounded by up to four Congregation seals
			The choir no longer answers its wardens
			'''
	}

	Unison: {
		DisplayName: Unison
		Tooltip:
			'''
			Clap spectral fists to release a closed Hollow Benediction
			The hymn expands from the smash and strikes each enemy once
			'''
	}

	Crux: {
		DisplayName: Crux
		Tooltip:
			'''
			Marks the cursor with a crossed sentence
			Both arms strike each enemy once
			Uses bullets
			'''
	}

	StarsOfRuin: {
		DisplayName: Stars of Ruin
		Tooltip:
			'''
			Fires twelve dark shooting stars that pursue a chosen foe
			Aim near a visible enemy to lock the volley onto it
			'''
	}

	SealedCongregationBag: {
		DisplayName: The Sealed Congregation Treasure Bag
		Tooltip: Right-click to open
	}

	WardensFragment: {
		DisplayName: Warden's Fragment
		Tooltip:
